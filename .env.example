# ---- Contact / lead form email delivery (Resend: https://resend.com) ----
# Add these in Vercel -> Project -> Settings -> Environment Variables (Production AND Preview), then redeploy.
# Never commit real values. Without all three, the form shows an error instead of pretending to send.

# API key from Resend (Dashboard -> API Keys). Server-side only: never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Where leads are delivered. One address, or several separated by commas.
CONTACT_TO_EMAIL=

# Sender. Must be on a domain you have verified in Resend (add the DNS records they give you), e.g.:
# Website Leads <leads@waterdamagerestoration-arizona.com>
CONTACT_FROM_EMAIL=

# Optional: override the API endpoint (only needed for testing/proxying). Leave unset in production.
# RESEND_API_URL=
